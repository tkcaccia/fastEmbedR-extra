Bootstrap: localimage
From: /mnt/sata_ssd/fastEmbedR/singularity/fastembedr_cuda_20260731_knn_r_packages.sif

%files
    /mnt/sata_ssd/fastEmbedR/singularity/build_20260731_kodama_f6cdef8/kodama-cpp-f6cdef8.tar.gz /opt/src/kodama-cpp-f6cdef8.tar.gz

%labels
    Author tkcaccia
    Project fastEmbedR
    KODAMACommit f6cdef85794d94619710a35f64462c95a02005e2
    KODAMARCommit f6cdef85794d94619710a35f64462c95a02005e2
    KODAMASourceSHA256 91362f22934c1a3105b7cb14390bb3b77e104e2e98b997dcf848f5a18c34d2c3
    KODAMARAPI data-raw-features-graph-precomputed
    KODAMAGraphAPI reusable-serialized-graph
    RcppHNSWVersion 0.7.0
    naborVersion 0.5.0
    rnndescentVersion 0.2.0
    CUDAArchitectures 75-80-86-89-90-120
    Description fastEmbedR CUDA benchmark image with updated KODAMA and R nearest-neighbor references

%environment
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/conda/bin:/opt/fit-sne/bin:$PATH
    export CONDA_PREFIX=/opt/conda
    export R_LIBS=/opt/conda/lib/R/library
    export R_LIBS_USER=/opt/conda/lib/R/library
    export R_LIBS_SITE=/opt/conda/lib/R/library
    export CUDA_HOME=/usr/local/cuda
    export KODAMA_HOME=/opt/kodama
    export LD_LIBRARY_PATH=/opt/rapids/lib:/opt/faiss/lib:/usr/local/cuda/lib64:/opt/conda/lib:/opt/conda/targets/x86_64-linux/lib:${LD_LIBRARY_PATH:-}

%post
    set -eux
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/conda/bin:/usr/local/cuda/bin:$PATH
    export CONDA_PREFIX=/opt/conda
    export CUDA_HOME=/usr/local/cuda
    export KODAMA_HOME=/opt/kodama
    export R_LIBS=/opt/conda/lib/R/library
    export R_LIBS_USER=/opt/conda/lib/R/library
    export R_LIBS_SITE=/opt/conda/lib/R/library
    export LD_LIBRARY_PATH=/opt/rapids/lib:/opt/faiss/lib:/usr/local/cuda/lib64:/opt/conda/lib:/opt/conda/targets/x86_64-linux/lib:${LD_LIBRARY_PATH:-}

    echo "91362f22934c1a3105b7cb14390bb3b77e104e2e98b997dcf848f5a18c34d2c3  /opt/src/kodama-cpp-f6cdef8.tar.gz" | sha256sum -c -

    rm -rf /opt/kodama-cpp
    tar -xzf /opt/src/kodama-cpp-f6cdef8.tar.gz -C /opt

    cmake -S /opt/kodama-cpp -B /opt/kodama-cpp/build-cuda \
      -DCMAKE_BUILD_TYPE=Release \
      -DKODAMA_BUILD_TESTS=OFF \
      -DKODAMA_BUILD_EXAMPLES=OFF \
      -DKODAMA_ENABLE_CUDA=ON \
      -DKODAMA_ENABLE_METAL=OFF \
      -DKODAMA_ENABLE_OPENMP=ON \
      -DCMAKE_AR=/opt/conda/bin/x86_64-conda-linux-gnu-ar \
      -DCMAKE_RANLIB=/opt/conda/bin/x86_64-conda-linux-gnu-ranlib \
      -DCMAKE_CUDA_ARCHITECTURES="75;80;86;89;90;120"
    cmake --build /opt/kodama-cpp/build-cuda -j 8

    rm -rf /opt/conda/lib/R/library/kodamaR
    KODAMA_CPP_ROOT=/opt/kodama-cpp \
    KODAMA_CPP_BUILD_DIR=/opt/kodama-cpp/build-cuda \
    KODAMA_R_CUDA_LIBS="-lcudart -lcublasLt -lcublas -lcusolver -lcusparse -lcurand -lcufft" \
    R CMD INSTALL /opt/kodama-cpp/split-repos/kodama-r

    Rscript - <<'EOF_R'
expected <- c(
  RcppHNSW = "0.7.0",
  nabor = "0.5.0",
  rnndescent = "0.2.0"
)
observed <- vapply(
  names(expected),
  function(package) as.character(utils::packageVersion(package)),
  character(1)
)
stopifnot(identical(observed, expected))

library(kodamaR)
matrix_formals <- names(formals(KODAMA.matrix))
stopifnot(
  "data" %in% matrix_formals,
  "graph" %in% matrix_formals,
  !"raw.data" %in% matrix_formals
)

set.seed(4)
centers <- matrix(rnorm(6L * 12L, sd = 3), 6L, 12L)
truth <- rep(seq_len(6L), each = 30L)
x <- centers[truth, ] +
  matrix(rnorm(length(truth) * 12L, sd = 0.35), length(truth), 12L)
graph <- KODAMA.graph(
  data = x,
  k = 20L,
  backend = "cpu",
  n.cores = 2L,
  seed = 4L
)
fit <- KODAMA.matrix(
  data = x,
  graph = graph,
  classifier = "knn",
  backend = "cpu",
  M = 1L,
  Tcycle = 2L,
  ncomp = 5L,
  landmarks = 80L,
  splitting = 6L,
  graph.neighbors = 20L,
  knn.k = 10L,
  n.cores = 2L,
  visual.init = TRUE,
  progress = FALSE
)
stopifnot(
  length(fit$best_labels) == nrow(x),
  is.null(fit$graph_builds) || identical(as.integer(fit$graph_builds), 0L)
)
cat("Updated KODAMA CPU graph-reuse validation passed\n")
EOF_R
