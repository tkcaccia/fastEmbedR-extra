+template <typename T>
+T bilinear_self_q_mass_t(const int grid_size, const T gx, const T gy, const T spacing) {
+  const T cx = std::max(static_cast<T>(0.0), std::min(static_cast<T>(grid_size - 1), gx));
+  const T cy = std::max(static_cast<T>(0.0), std::min(static_cast<T>(grid_size - 1), gy));
+  const int x0 = std::max(0, std::min(grid_size - 2, static_cast<int>(std::floor(cx))));
+  const int y0 = std::max(0, std::min(grid_size - 2, static_cast<int>(std::floor(cy))));
+  const T tx = cx - static_cast<T>(x0);
+  const T ty = cy - static_cast<T>(y0);
+  const int xs[4] = {x0, x0 + 1, x0, x0 + 1};
+  const int ys[4] = {y0, y0, y0 + 1, y0 + 1};
+  const T weights[4] = {
+    (static_cast<T>(1.0) - tx) * (static_cast<T>(1.0) - ty),
+    tx * (static_cast<T>(1.0) - ty),
+    (static_cast<T>(1.0) - tx) * ty,
+    tx * ty
+  };
+  T self_mass = static_cast<T>(0.0);
+  for (int a = 0; a < 4; ++a) {
+    for (int b = 0; b < 4; ++b) {
+      const T dx = static_cast<T>(xs[a] - xs[b]) * spacing;
+      const T dy = static_cast<T>(ys[a] - ys[b]) * spacing;
+      self_mass += weights[a] * weights[b] /
+        (static_cast<T>(1.0) + dx * dx + dy * dy);
+    }
+  }
+  return self_mass;
+}
